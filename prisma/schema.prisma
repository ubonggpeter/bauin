generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ╔══════════════════════════════════════════════╗
// ║                   ENUMS                      ║
// ╚══════════════════════════════════════════════╝

enum UserRole {
  SUPER_ADMIN
  ADMIN
  WORKER
  DISTRIBUTOR
  SELLER
  VIEWER
}

enum UserRank {
  MEMBER
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
  BILLIONAIRE
  BILLIONAIRE_ELITE
}

enum KycStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

enum AnnouncementType {
  INFO
  WARNING
  PROMOTION
}

enum AnnouncementTarget {
  ALL
  WORKERS
  SELLERS
  DISTRIBUTORS
  VIEWERS
}

enum WorkerStatus {
  AVAILABLE
  BUSY
  ON_LEAVE
}

enum FraudFlagType {
  RAPID_ANSWERS       // any answer submitted under 0.8 s
  SAME_IP_QUIZ_REPLAY // same IP joins same quiz 3+ times in one day
  SHARED_PHONE        // phone number registered on multiple accounts
}

enum FraudSeverity {
  LOW
  MEDIUM
  HIGH
}

enum FraudFlagStatus {
  PENDING
  CONFIRMED
  DISMISSED
}

enum FraudAppealStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RetryPolicy {
  IMMEDIATE
  AFTER_24H
  AFTER_7D
  AFTER_30D
}

enum TestAttemptStatus {
  IN_PROGRESS
  CERTIFIED
  FAILED
  ABANDONED
}

enum CorrectOption {
  A
  B
  C
  D
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  REFERRAL_BONUS
  INVESTMENT_RETURN
  STORY_PURCHASE
  BUNDLE_PURCHASE
  CATEGORY_REGISTRATION
  CATEGORY_MONTHLY_FEE
  CATEGORY_RETRY_FEE
  BET_STAKE
  BET_PAYOUT
  TOOL_POOL_FEE
  ACHIEVEMENT_BONUS
  LEADERBOARD_PRIZE
  ADJUSTMENT
  JOB_ESCROW
  JOB_PAYMENT
  AFFILIATE_BONUS
  MILESTONE_BONUS
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum BetType {
  TOP1
  TOP3
  TOP5
  TOP10
}

enum BetStatus {
  OPEN
  SETTLED
  CANCELLED
}

enum ReferralType {
  WORKER
  VIEWER
}

enum WithdrawalStatus {
  QUEUED
  PENDING_ADMIN
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum TournamentStatus {
  UPCOMING
  LIVE
  ENDED
}

enum InvestmentRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CONVERTED
}

enum InvestmentStatus {
  PENDING
  ACTIVE
  MATURED
  CANCELLED
}

enum ToolPoolMemberRole {
  OWNER
  MEMBER
}

enum ToolPoolStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum ToolPoolMemberStatus {
  ACTIVE
  SUSPENDED
  LEFT
}

enum NotificationType {
  EMAIL_VERIFICATION
  WELCOME_AFTER_PAYMENT
  CERTIFICATION_PASSED
  CERTIFICATION_FAILED
  STORY_APPROVED
  STORY_SALE
  QUIZ_WIN
  BET_WIN
  BET_LOSS
  REFERRAL_EARNED
  REFERRAL_VIEWER_UNLOCKED
  WITHDRAWAL_PROCESSED
  INVESTMENT_FUNDED
  WEEKLY_LEADERBOARD
  ANNOUNCEMENT
  JOB_NEW_APPLICATION
  JOB_ASSIGNED
  JOB_SUBMITTED
  JOB_APPROVED
  AFFILIATE_APPROVED
  AFFILIATE_REJECTED
  AFFILIATE_BONUS_EARNED
}

// ╔══════════════════════════════════════════════╗
// ║               CORE — USER                    ║
// ╚══════════════════════════════════════════════╝

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          UserRole  @default(VIEWER)
  referralCode  String    @unique @map("referral_code")
  referredById  String?   @map("referred_by_id")
  referredBy    User?     @relation("UserReferrals", fields: [referredById], references: [id])
  referrals     User[]    @relation("UserReferrals")
  kycStatus     KycStatus    @default(PENDING) @map("kyc_status")
  rank          UserRank     @default(MEMBER)
  workerStatus  WorkerStatus @default(AVAILABLE) @map("worker_status")
  walletBalance Decimal   @default(0) @db.Decimal(18, 2) @map("wallet_balance")
  phoneNumber   String?   @map("phone_number")
  country       String?
  avatarUrl     String?   @map("avatar_url")
  emailVerifiedAt    DateTime? @map("email_verified_at")
  resetToken         String?   @map("reset_token")
  resetTokenExpiry   DateTime? @map("reset_token_expiry")
  twoFactorSecret    String?   @map("two_factor_secret")
  twoFactorEnabled   Boolean   @default(false) @map("two_factor_enabled")
  isActive             Boolean   @default(true) @map("is_active")
  lastLoginAt          DateTime? @map("last_login_at")
  loginStreak          Int       @default(0) @map("login_streak")
  loginStreakUpdatedAt DateTime? @map("login_streak_updated_at")
  ninHash              String?   @unique @map("nin_hash")
  fraudSuspendedAt     DateTime? @map("fraud_suspended_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  wallet                 Wallet?
  userCategories         UserCategory[]
  topicProgress          UserTopicProgress[]
  testAttempts           TestAttempt[]
  certificates           UserCertificate[]
  achievements           UserAchievement[]
  storyPurchases         StoryPurchase[]
  distributorCollections DistributorCollection[]
  quizEntries            QuizEntry[]
  bets                   Bet[]
  transactions           Transaction[]
  referralsGiven         Referral[]        @relation("ReferralReferrer")
  referralsReceived      Referral[]        @relation("ReferralReferred")
  investmentRequests     InvestmentRequest[]
  investmentsAsInvestor  Investment[] @relation("InvestmentInvestor")
  investmentsAsWorker    Investment[] @relation("InvestmentWorker")
  toolPoolMemberships    ToolPoolMember[]
  ownedToolPools         ToolPool[]       @relation("ToolPoolOwner")
  notifications          Notification[]
  auditLogs              AuditLog[]       @relation("AuditLogAdmin")
  withdrawalRequests     WithdrawalRequest[]
  scriptGenerations      ScriptGeneration[]
  pushSubscriptions      PushSubscription[]
  kycDocument            KycDocument?
  fraudFlags             FraudFlag[]
  fraudAppeals           FraudAppeal[]
  postedJobs             Job[]             @relation("JobPoster")
  assignedJobs           Job[]             @relation("JobWorker")
  jobApplications        JobApplication[]  @relation("JobApplications")
  affiliate              Affiliate?        @relation("AffiliateUser")
  affiliateReferralReceived AffiliateReferral? @relation("AffiliateReferredUser")
  affiliateReviews       Affiliate[]       @relation("AffiliateReviewer")
  supportTickets         SupportTicket[]   @relation("UserSupportTickets")
  assignedSupportTickets SupportTicket[]   @relation("TicketAssignee")
  storyBundles           StoryBundle[]
  bundlePurchases        BundlePurchase[]
  storyCollaborations    StoryCollaborator[] @relation("StoryCollaborations")
  subscriptions          SellerSubscription[] @relation("SubscriberSubscriptions")
  subscribers            SellerSubscription[] @relation("SellerSubscribers")
  tournamentEntries      TournamentEntry[]
  tournamentBets         TournamentBet[]

  @@index([referredById])
  @@index([referralCode])
  @@map("users")
}

// ╔══════════════════════════════════════════════╗
// ║           CATEGORY & COURSE TREE             ║
// ╚══════════════════════════════════════════════╝

model Category {
  id               String      @id @default(cuid())
  name             String      @unique
  slug             String      @unique
  description      String?     @db.Text
  registrationFee  Decimal     @db.Decimal(18, 2) @map("registration_fee")
  monthlyFee       Decimal     @db.Decimal(18, 2) @map("monthly_fee")
  retryFee         Decimal     @db.Decimal(18, 2) @map("retry_fee")
  retryPolicy      RetryPolicy @default(IMMEDIATE) @map("retry_policy")
  passPercentage   Int         @default(70) @map("pass_percentage")
  questionCount    Int         @default(20) @map("question_count")
  isActive         Boolean     @default(true) @map("is_active")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  userCategories UserCategory[]
  courses        Course[]
  testQuestions  TestQuestion[]
  testAttempts   TestAttempt[]
  certificates   UserCertificate[]
  quizSessions   QuizSession[]
  jobs           Job[]

  @@map("categories")
}

model UserCategory {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId       String    @map("category_id")
  category         Category  @relation(fields: [categoryId], references: [id])
  subscribedAt     DateTime  @default(now()) @map("subscribed_at")
  expiresAt        DateTime? @map("expires_at")
  isActive         Boolean   @default(true) @map("is_active")
  paidRegistration Boolean   @default(false) @map("paid_registration")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@unique([userId, categoryId])
  @@index([userId])
  @@index([categoryId])
  @@map("user_categories")
}

model Course {
  id          String   @id @default(cuid())
  categoryId  String   @map("category_id")
  category    Category @relation(fields: [categoryId], references: [id])
  title       String
  description String?  @db.Text
  coverUrl    String?  @map("cover_url")
  order       Int      @default(0)
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  topics Topic[]

  @@index([categoryId])
  @@map("courses")
}

model Topic {
  id          String   @id @default(cuid())
  courseId    String   @map("course_id")
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subTopics SubTopic[]

  @@index([courseId])
  @@map("topics")
}

model SubTopic {
  id        String   @id @default(cuid())
  topicId   String   @map("topic_id")
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title     String
  content   String?  @db.Text
  mediaUrl  String?  @map("media_url")
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userProgress UserTopicProgress[]

  @@index([topicId])
  @@map("sub_topics")
}

model UserTopicProgress {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subTopicId   String    @map("sub_topic_id")
  subTopic     SubTopic  @relation(fields: [subTopicId], references: [id], onDelete: Cascade)
  completed    Boolean   @default(false)
  completedAt  DateTime? @map("completed_at")
  timeSpentSec Int       @default(0) @map("time_spent_sec")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([userId, subTopicId])
  @@index([userId])
  @@map("user_topic_progress")
}

// ╔══════════════════════════════════════════════╗
// ║                   TESTS                      ║
// ╚══════════════════════════════════════════════╝

model TestQuestion {
  id            String        @id @default(cuid())
  categoryId    String        @map("category_id")
  category      Category      @relation(fields: [categoryId], references: [id])
  questionText  String        @db.Text @map("question_text")
  optionA       String        @map("option_a")
  optionB       String        @map("option_b")
  optionC       String        @map("option_c")
  optionD       String        @map("option_d")
  correctOption CorrectOption @map("correct_option")
  explanation   String?       @db.Text
  difficulty    Int           @default(1)
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([categoryId])
  @@map("test_questions")
}

// answers_json: { [questionId]: "A" | "B" | "C" | "D" }
model TestAttempt {
  id             String            @id @default(cuid())
  userId         String            @map("user_id")
  user           User              @relation(fields: [userId], references: [id])
  categoryId     String            @map("category_id")
  category       Category          @relation(fields: [categoryId], references: [id])
  status         TestAttemptStatus @default(IN_PROGRESS) @map("status")
  scorePct       Decimal?          @db.Decimal(5, 2) @map("score_pct")
  passed         Boolean?
  answersJson    Json?             @map("answers_json")
  questionData   Json?             @map("question_data")
  startedAt      DateTime          @default(now()) @map("started_at")
  completedAt    DateTime?         @map("completed_at")
  durationSec    Int?              @map("duration_sec")
  isRetry        Boolean           @default(false) @map("is_retry")
  retryFeePaid   Boolean           @default(false) @map("retry_fee_paid")
  certificateUrl String?           @map("certificate_url")
  createdAt      DateTime          @default(now()) @map("created_at")

  answers     TestAnswer[]
  certificate UserCertificate?

  @@index([userId])
  @@index([categoryId])
  @@index([userId, categoryId])
  @@index([status])
  @@map("test_attempts")
}

model TestAnswer {
  id            String      @id @default(cuid())
  attemptId     String      @map("attempt_id")
  attempt       TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId    String      @map("question_id")
  displayAnswer String?     @map("display_answer")
  mappedAnswer  String?     @map("mapped_answer")
  answeredAt    DateTime?   @map("answered_at")
  timeTakenMs   Int?        @map("time_taken_ms")
  flaggedFast   Boolean     @default(false) @map("flagged_fast")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("test_answers")
}

model UserCertificate {
  id             String      @id @default(cuid())
  publicId       String      @unique @map("public_id")
  userId         String      @map("user_id")
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId     String      @map("category_id")
  category       Category    @relation(fields: [categoryId], references: [id])
  attemptId      String      @unique @map("attempt_id")
  attempt        TestAttempt @relation(fields: [attemptId], references: [id])
  score          Int
  certificateUrl String      @map("certificate_url")
  issuedAt       DateTime    @default(now()) @map("issued_at")

  @@unique([userId, categoryId])
  @@index([userId])
  @@map("user_certificates")
}

model Achievement {
  id          String            @id @default(cuid())
  key         String            @unique
  name        String
  description String
  icon        String
  createdAt   DateTime          @default(now()) @map("created_at")
  users       UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String      @map("user_id")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String      @map("achievement_id")
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  earnedAt      DateTime    @default(now()) @map("earned_at")

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}

// ╔══════════════════════════════════════════════╗
// ║              STORIES & EPISODES              ║
// ╚══════════════════════════════════════════════╝

model Story {
  id             String   @id @default(cuid())
  title          String
  description    String?  @db.Text
  coverUrl       String?  @map("cover_url")
  authorId       String?  @map("author_id")
  isPublished    Boolean  @default(false) @map("is_published")
  isFree         Boolean  @default(false) @map("is_free")
  price          Decimal  @default(0) @db.Decimal(18, 2)
  niche          String?
  tags           String[]
  royaltyEnabled Boolean  @default(false) @map("royalty_enabled")
  royaltyPct     Decimal  @default(0) @db.Decimal(5, 2) @map("royalty_pct")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  episodes      Episode[]
  purchases     StoryPurchase[]
  bundleItems   StoryBundleItem[]
  collaborators StoryCollaborator[]

  @@index([niche])
  @@map("stories")
}

model StoryCollaborator {
  id              String   @id @default(cuid())
  storyId         String   @map("story_id")
  collaboratorId  String   @map("collaborator_id")
  role            String   @default("CO-WRITER")
  revenueSharePct Decimal  @default(0) @db.Decimal(5, 2) @map("revenue_share_pct")
  invitedAt       DateTime @default(now()) @map("invited_at")

  story        Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  collaborator User  @relation("StoryCollaborations", fields: [collaboratorId], references: [id])

  @@unique([storyId, collaboratorId])
  @@index([collaboratorId])
  @@map("story_collaborators")
}

model SellerSubscription {
  id           String   @id @default(cuid())
  subscriberId String   @map("subscriber_id")
  sellerId     String   @map("seller_id")
  autoPurchase Boolean  @default(false) @map("auto_purchase")
  createdAt    DateTime @default(now()) @map("created_at")

  subscriber   User @relation("SubscriberSubscriptions", fields: [subscriberId], references: [id])
  seller       User @relation("SellerSubscribers", fields: [sellerId], references: [id])

  @@unique([subscriberId, sellerId])
  @@index([sellerId])
  @@map("seller_subscriptions")
}

// game_content_json shape:
// {
//   phase1: { type: "memory_grid", cards: [...], timeLimit: 30 },
//   phase2: { type: "sequence",    sequence: [...], timeLimit: 25 },
//   phase3: { type: "match_pairs", pairs: [...],    timeLimit: 40 },
//   phase4: { type: "fill_blank",  prompts: [...],  timeLimit: 35 },
//   phase5: { type: "speed_recall",items: [...],    timeLimit: 20 }
// }
model Episode {
  id              String   @id @default(cuid())
  storyId         String   @map("story_id")
  story           Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  title           String
  episodeNumber   Int      @map("episode_number")
  description     String?  @db.Text
  textContent     String?  @db.Text @map("text_content")
  contentUrl      String?  @map("content_url")
  previewUrl      String?  @map("preview_url")
  gameContentJson Json     @map("game_content_json")
  isFree          Boolean  @default(false) @map("is_free")
  price           Decimal  @default(0) @db.Decimal(18, 2)
  qualityScore    Json?    @map("quality_score")
  isPublished     Boolean  @default(false) @map("is_published")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  purchases    StoryPurchase[]
  quizSessions QuizSession[]

  @@unique([storyId, episodeNumber])
  @@index([storyId])
  @@map("episodes")
}

model StoryPurchase {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id])
  storyId     String?  @map("story_id")
  story       Story?   @relation(fields: [storyId], references: [id])
  episodeId   String?  @map("episode_id")
  episode     Episode? @relation(fields: [episodeId], references: [id])
  amountPaid     Decimal  @db.Decimal(18, 2) @map("amount_paid")
  isAutoPurchase Boolean  @default(false) @map("is_auto_purchase")
  purchasedAt    DateTime @default(now()) @map("purchased_at")

  @@unique([userId, storyId])
  @@unique([userId, episodeId])
  @@index([userId])
  @@map("story_purchases")
}

// ╔══════════════════════════════════════════════╗
// ║        DISTRIBUTOR COLLECTIONS               ║
// ╚══════════════════════════════════════════════╝

model DistributorCollection {
  id                  String    @id @default(cuid())
  userId              String    @map("user_id")
  user                User      @relation(fields: [userId], references: [id])
  name                String
  publicLinkCode      String    @unique @map("public_link_code")
  customAlias         String?   @unique @map("custom_alias")
  isInUse             Boolean   @default(false) @map("is_in_use")
  scheduledActivateAt DateTime? @map("scheduled_activate_at")
  description         String?   @db.Text
  maxParticipants     Int?      @map("max_participants")
  ctaText             String?   @map("cta_text")
  accentColor         String?   @map("accent_color")
  logoUrl             String?   @map("logo_url")
  welcomeMessage      String?   @db.Text @map("welcome_message")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  quizSessions QuizSession[]

  @@index([userId])
  @@index([publicLinkCode])
  @@index([customAlias])
  @@map("distributor_collections")
}

// ╔══════════════════════════════════════════════╗
// ║           QUIZ SESSIONS & ENTRIES            ║
// ╚══════════════════════════════════════════════╝

model QuizSession {
  id                      String                 @id @default(cuid())
  categoryId              String?                @map("category_id")
  category                Category?              @relation(fields: [categoryId], references: [id])
  episodeId               String?                @map("episode_id")
  episode                 Episode?               @relation(fields: [episodeId], references: [id])
  distributorCollectionId String?                @map("distributor_collection_id")
  distributorCollection   DistributorCollection? @relation(fields: [distributorCollectionId], references: [id])
  title                   String?
  status                  String                 @default("PENDING")
  startedAt               DateTime?              @map("started_at")
  endedAt                 DateTime?              @map("ended_at")
  createdAt               DateTime               @default(now()) @map("created_at")

  entries     QuizEntry[]
  bets        Bet[]
  tournaments Tournament[]

  @@index([distributorCollectionId])
  @@map("quiz_sessions")
}

// phase1–5 map to the 5 memory-game phases in Episode.gameContentJson
model QuizEntry {
  id            String      @id @default(cuid())
  quizSessionId String      @map("quiz_session_id")
  quizSession   QuizSession @relation(fields: [quizSessionId], references: [id])
  userId        String      @map("user_id")
  user          User        @relation(fields: [userId], references: [id])
  phase1Score   Int         @default(0) @map("phase1_score")
  phase2Score   Int         @default(0) @map("phase2_score")
  phase3Score   Int         @default(0) @map("phase3_score")
  phase4Score   Int         @default(0) @map("phase4_score")
  phase5Score   Int         @default(0) @map("phase5_score")
  totalScore    Int         @default(0) @map("total_score")
  rank            Int?
  ipAddress       String?   @map("ip_address")
  minAnswerTimeMs Int?      @map("min_answer_time_ms")
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@unique([quizSessionId, userId])
  @@index([quizSessionId])
  @@index([userId])
  @@map("quiz_entries")
}

// ╔══════════════════════════════════════════════╗
// ║                    BETS                      ║
// ╚══════════════════════════════════════════════╝

// predictedIds: string[] — IDs of QuizEntry users predicted to finish TOP-N
model Bet {
  id            String      @id @default(cuid())
  userId        String      @map("user_id")
  user          User        @relation(fields: [userId], references: [id])
  quizSessionId String      @map("quiz_session_id")
  quizSession   QuizSession @relation(fields: [quizSessionId], references: [id])
  type          BetType
  stake         Decimal     @db.Decimal(18, 2)
  predictedIds  Json        @map("predicted_ids")
  payout        Decimal?    @db.Decimal(18, 2)
  status        BetStatus   @default(OPEN)
  settledAt     DateTime?   @map("settled_at")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([userId])
  @@index([quizSessionId])
  @@map("bets")
}

// ╔══════════════════════════════════════════════╗
// ║              WALLET & TRANSACTIONS           ║
// ╚══════════════════════════════════════════════╝

model Wallet {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  user           User     @relation(fields: [userId], references: [id])
  balance        Decimal  @default(0) @db.Decimal(18, 2)
  totalDeposited Decimal  @default(0) @db.Decimal(18, 2) @map("total_deposited")
  totalWithdrawn Decimal  @default(0) @db.Decimal(18, 2) @map("total_withdrawn")
  totalEarned    Decimal  @default(0) @db.Decimal(18, 2) @map("total_earned")
  updatedAt      DateTime @updatedAt @map("updated_at")

  transactions Transaction[]

  @@map("wallets")
}

model Transaction {
  id            String            @id @default(cuid())
  walletId      String            @map("wallet_id")
  wallet        Wallet            @relation(fields: [walletId], references: [id])
  userId        String            @map("user_id")
  user          User              @relation(fields: [userId], references: [id])
  type          TransactionType
  amount        Decimal           @db.Decimal(18, 2)
  balanceBefore Decimal           @db.Decimal(18, 2) @map("balance_before")
  balanceAfter  Decimal           @db.Decimal(18, 2) @map("balance_after")
  description   String?
  reference     String?           @unique
  status        TransactionStatus @default(PENDING)
  metadata      Json?
  createdAt     DateTime          @default(now()) @map("created_at")

  withdrawalRequest WithdrawalRequest?

  @@index([walletId])
  @@index([userId])
  @@index([createdAt])
  @@map("transactions")
}

model WithdrawalRequest {
  id                    String           @id @default(cuid())
  userId                String           @map("user_id")
  user                  User             @relation(fields: [userId], references: [id])
  transactionId         String           @unique @map("transaction_id")
  transaction           Transaction      @relation(fields: [transactionId], references: [id])
  amount                Decimal          @db.Decimal(18, 2)
  accountNumber         String           @map("account_number")
  bankName              String           @map("bank_name")
  accountName           String           @map("account_name")
  bankCode              String?          @map("bank_code")
  status                WithdrawalStatus @default(QUEUED)
  autoApproved          Boolean          @default(false) @map("auto_approved")
  paystackRecipientCode String?          @map("paystack_recipient_code")
  paystackTransferCode  String?          @map("paystack_transfer_code")
  paystackReference     String?          @unique @map("paystack_reference")
  failureReason         String?          @map("failure_reason")
  adminNote             String?          @map("admin_note")
  processedAt           DateTime?        @map("processed_at")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@map("withdrawal_requests")
}

// ╔══════════════════════════════════════════════╗
// ║                 REFERRALS                    ║
// ╚══════════════════════════════════════════════╝

model Referral {
  id               String       @id @default(cuid())
