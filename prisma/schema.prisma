// ╔══════════════════════════════════════════════╗
// ║             SUPPORT / HELPDESK               ║
// ╚══════════════════════════════════════════════╝

enum SupportTicketStatus {
  BOT         // AI is handling; fewer than 3 AI replies
  OPEN        // Escalated to human, awaiting admin
  IN_PROGRESS // Admin has picked it up
  RESOLVED
  CLOSED
}

model SupportTicket {
  id           String              @id @default(cuid())
  userId       String?             @map("user_id")
  user         User?               @relation("UserSupportTickets", fields: [userId], references: [id])
  subject      String?             @db.Text
  status       SupportTicketStatus @default(BOT)
  aiReplies    Int                 @default(0) @map("ai_replies")
  assignedToId String?             @map("assigned_to_id")
  assignedTo   User?               @relation("TicketAssignee", fields: [assignedToId], references: [id])
  resolvedAt   DateTime?           @map("resolved_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  messages SupportMessage[]

  @@index([userId])
  @@index([status])
  @@index([assignedToId])
  @@map("support_tickets")
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String        @map("ticket_id")
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  role      String        // "user" | "assistant" | "admin"
  body      String        @db.Text
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([ticketId, createdAt(sort: Asc)])
  @@map("support_messages")
}

// ╔══════════════════════════════════════════════╗
// ║             STORY BUNDLES                    ║
// ╚══════════════════════════════════════════════╝

model StoryBundle {
  id           String   @id @default(cuid())
  sellerId     String   @map("seller_id")
  seller       User     @relation(fields: [sellerId], references: [id])
  title        String
  description  String?  @db.Text
  bundlePrice  Decimal  @db.Decimal(18, 2) @map("bundle_price")
  isPublished  Boolean  @default(false) @map("is_published")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  items     StoryBundleItem[]
  purchases BundlePurchase[]

  @@index([sellerId])
  @@index([isPublished])
  @@map("story_bundles")
}

model StoryBundleItem {
  id        String      @id @default(cuid())
  bundleId  String      @map("bundle_id")
  bundle    StoryBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  storyId   String      @map("story_id")
  story     Story       @relation(fields: [storyId], references: [id])
  order     Int         @default(0)
  createdAt DateTime    @default(now()) @map("created_at")

  @@unique([bundleId, storyId])
  @@index([bundleId])
  @@map("story_bundle_items")
}

model BundlePurchase {
  id          String      @id @default(cuid())
  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id])
  bundleId    String      @map("bundle_id")
  bundle      StoryBundle @relation(fields: [bundleId], references: [id])
  amountPaid  Decimal     @db.Decimal(18, 2) @map("amount_paid")
  purchasedAt DateTime    @default(now()) @map("purchased_at")

  @@unique([userId, bundleId])
  @@index([userId])
  @@index([bundleId])
  @@map("bundle_purchases")
}

// ╔══════════════════════════════════════════════╗
// ║              TOURNAMENTS                     ║
// ╚══════════════════════════════════════════════╝

model Tournament {
  id            String           @id @default(cuid())
  name          String
  description   String?          @db.Text
  entryFee      Decimal          @db.Decimal(18, 2) @map("entry_fee")
  prizePool     Decimal          @db.Decimal(18, 2) @map("prize_pool")
  quizSessionId String           @map("quiz_session_id")
  quizSession   QuizSession      @relation(fields: [quizSessionId], references: [id])
  date          DateTime
  status        TournamentStatus @default(UPCOMING)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  entries TournamentEntry[]
  bets    TournamentBet[]

  @@index([status])
  @@index([date])
  @@map("tournaments")
}

// One entry per user per tournament (paid entry)
model TournamentEntry {
  id           String     @id @default(cuid())
  tournamentId String     @map("tournament_id")
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String     @map("user_id")
  user         User       @relation(fields: [userId], references: [id])
  paystackRef  String     @map("paystack_ref")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([tournamentId, userId])
  @@index([tournamentId])
  @@index([userId])
  @@map("tournament_entries")
}

// One bet per user per tournament; predictedIds = [userId1, userId2, userId3] (predicted Top 3)
model TournamentBet {
  id           String     @id @default(cuid())
  tournamentId String     @map("tournament_id")
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String     @map("user_id")
  user         User       @relation(fields: [userId], references: [id])
  predictedIds Json       @map("predicted_ids")
  stake        Decimal    @db.Decimal(18, 2)
  paystackRef  String     @map("paystack_ref")
  payout       Decimal?   @db.Decimal(18, 2)
  settled      Boolean    @default(false)
  settledAt    DateTime?  @map("settled_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([tournamentId, userId])
  @@index([tournamentId])
  @@index([userId])
  @@map("tournament_bets")
}
