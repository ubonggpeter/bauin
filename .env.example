# ─────────────────────────────────────────────
# BAUIN Platform — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── Next.js ──────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Backend ──────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# ── Database (PostgreSQL) ────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/bauin_db

# ── Auth ─────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
# Separate secret for admin sessions (falls back to JWT_SECRET if unset)
ADMIN_JWT_SECRET=your-admin-jwt-secret-different-from-main

# ── NextAuth ──────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# ── Redis ────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Email — SendGrid (primary) ───────────────
# Get from https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your-sendgrid-api-key
EMAIL_FROM=noreply@bauin.app

# ── Email — SMTP fallback (optional, used if SENDGRID_API_KEY is absent) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your-app-password

# ── Paystack ─────────────────────────────────
# Server-side secret key (never expose to client)
PAYSTACK_SECRET_KEY=sk_test_...
# Client-side public key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...

# ── Cloudflare R2 Storage ────────────────────
# Account ID found in R2 dashboard URL
R2_ACCOUNT_ID=your-cloudflare-account-id
# R2 API token with Object Read & Write permissions
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Bucket name created in your R2 dashboard
R2_BUCKET_NAME=bauin-media
# Optional: public domain for the bucket (e.g. https://media.bauin.app)
# If not set, signed URLs are generated on demand (1-hour TTL)
R2_PUBLIC_URL=
# Optional: CDN domain that proxies R2 (e.g. https://cdn.bauin.app)
# When set, all R2 asset URLs are rewritten to the CDN origin
CDN_URL=
# Public CDN URL used in the browser (mirrors CDN_URL)
NEXT_PUBLIC_CDN_URL=

# ── Database connection pool ─────────────────
# Number of connections Prisma keeps open (default: 10)
DB_POOL_SIZE=10

# ── Socket.IO ────────────────────────────────
SOCKET_CORS_ORIGIN=http://localhost:3000

# ── Bull Queue ───────────────────────────────
QUEUE_CONCURRENCY=5

# ── Misc ─────────────────────────────────────
LOG_LEVEL=info

# ── Web Push (VAPID) ─────────────────────────
# Generate with: node -e "const wp=require('web-push');console.log(wp.generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=push@bauin.com

# ── Sentry ───────────────────────────────────
# Create a project at https://sentry.io and paste the DSN below
# NEXT_PUBLIC_SENTRY_DSN is exposed to the browser bundle
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Auth token for source-map upload — CI/CD secrets only, never commit
SENTRY_AUTH_TOKEN=
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=bauin-platform
